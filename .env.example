HOSTEL_API_PORT=3001
DATABASE_URL="postgresql://user:password@host/dbname"
HOSTEL_UPLOADS_DIR=uploads

# JWT Authentication Config — generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Redis Configuration for Rate Limiting
REDIS_URL=redis://127.0.0.1:6379

# Seeding Passwords (Required — the app refuses to start without them)
SEED_STUDENT_PASSWORD=ChangeMeStudent123!
SEED_WARDEN_PASSWORD=ChangeMeWarden123!
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
